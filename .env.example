# Standalone PropertyOps server settings
PORT=3000
DATABASE_PATH=./data/propertyops.sqlite
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
NODE_ENV=development

# One-time admin bootstrap only. Do not copy these values into production compose files.
# Supply them only for the bootstrap command, then remove them from the shell environment.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-long-random-password
